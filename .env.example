# Copy to .env.local for local development. In Vercel, add these under
# Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The "anon" / "publishable" key. Safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / "secret" key. Server only. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=
